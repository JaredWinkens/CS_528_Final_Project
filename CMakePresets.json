{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "description": "Configure the Chat Client",
      "binaryDir": "${sourceDir}/build/debug",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "description": "Build the Chat Client",
      "configurePreset": "default",
      "targets": [
        "Chat_Client",
        "Chat_Server"
      ],
      "verbose": true
    }
  ]
}
