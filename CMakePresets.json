{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "description": "Generate the applications with GNU Make",
      "binaryDir": "${sourceDir}/build/",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja",
      "description": "Generate the applications with Ninja",
      "binaryDir": "${sourceDir}/build/",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "description": "Build the applications with GNU Make",
      "configurePreset": "default",
      "targets": [
        "Chat_Client",
        "Chat_Server"
      ],
      "verbose": true
    },
    {
      "name": "ninja",
      "description": "Build the applications with Ninja",
      "configurePreset": "default",
      "targets": [
        "Chat_Client",
        "Chat_Server"
      ],
      "verbose": true
    }
  ]
}
